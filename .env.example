# Copy to .env and fill in. .env is gitignored — it holds credentials and
# machine-specific ports.

# Postgres container credentials (docker compose reads these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cueflo

# Host port for the db container. The container always listens on 5432
# internally; change this only if something else already owns the port
# locally (Postgres.app, another project).
DB_PORT=5433

# How the app reaches Postgres.
#   local dev:  postgresql://USER:PASSWORD@localhost:${DB_PORT}/cueflo
#   in compose: postgresql://USER:PASSWORD@db:5432/cueflo   (service name, not localhost)
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/cueflo

# Signs the session JWT. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Host port for the web container
WEB_PORT=3000
